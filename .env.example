# ==========================================
# My Lich Server Configuration (.env)
# ==========================================

# Server Host & Port & Domain (for Traefik)
HOST=0.0.0.0
PORT=3000
DOMAIN=lich.products.codechovui.dev
LOG_LEVEL=info

# Database Path (inside container or host)
DATABASE_PATH=/data/lich.db

# Security: JWT Secret (Generate a strong random string)
JWT_SECRET=change-this-to-a-secure-random-secret-in-production

# Reverse Proxy (Set true if behind Nginx, Caddy, Cloudflare, Traefik)
TRUST_PROXY=true

# Google Calendar Integration (Optional)
# Leave empty or omit to automatically use FakeGoogleProvider for offline development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lich.products.codechovui.dev/api/v1/auth/google/callback
USE_FAKE_GOOGLE=false
