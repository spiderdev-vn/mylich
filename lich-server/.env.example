# Server Configuration
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/lich.db
JWT_SECRET=supersecret-dev-jwt-key-replace-in-production-32chars
LOG_LEVEL=info

# Reverse Proxy Configuration (Nginx, Caddy, Cloudflare, Traefik, Docker ingress)
# Set to true, 1, or comma-separated IPs (e.g. '127.0.0.1,10.0.0.0/8')
TRUST_PROXY=false

# Google Calendar Integration (Phase 3)
# Leave empty or omit to automatically use FakeGoogleProvider for offline development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
USE_FAKE_GOOGLE=false
