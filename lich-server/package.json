{
  "name": "lich-server",
  "version": "0.1.0",
  "description": "Self-hosted calendar backend for Lich",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "build": "tsc",
    "test": "node --test test/**/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "calendar",
    "fastify",
    "sqlite",
    "lich"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "neostandard": "^0.13.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.2"
  }
}
